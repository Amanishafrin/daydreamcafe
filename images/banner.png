     <script>
      (function () {
        function initSlider(container) {
          var track = container.querySelector('[data-slider-track]');
          if (!track) return;

          var slides = track.children;
          var prev = container.querySelector('[data-prev]');
          var next = container.querySelector('[data-next]');
          var dotsWrap = container.querySelector('[data-dots]');
          var index = 0;
          var timer = null;

          var autoplay = container.dataset.autoplay === "true";
          var speed = (parseInt(container.dataset.speed) || 4) * 1000;
          var pauseOnHover = container.dataset.pause === "true";

          function go(i) {
            index = Math.max(0, Math.min(i, slides.length - 1));
            track.scrollTo({
              left: slides[index].offsetLeft,
              behavior: 'smooth'
            });
            update();
          }

          function update() {
            if (!dotsWrap) return;
            dotsWrap.querySelectorAll('button').forEach(function (d, i) {
              d.classList.toggle('is-active', i === index);
            });
          }

          function nextSlide() {
            go(index >= slides.length - 1 ? 0 : index + 1);
          }

          if (prev) prev.onclick = () => go(index - 1);
          if (next) next.onclick = () => go(index + 1);

          track.addEventListener('scroll', function () {
            var step = slides[1] ? slides[1].offsetLeft - slides[0].offsetLeft : slides[0].offsetWidth;
            index = Math.round(track.scrollLeft / step);
            update();
          });

          // dots
          if (dotsWrap) {
            dotsWrap.innerHTML = '';
            for (let i = 0; i < slides.length; i++) {
              let b = document.createElement('button');
              b.className = 'dot';
              b.onclick = () => go(i);
              dotsWrap.appendChild(b);
            }
            update();
          }

          // autoplay
          function start() {
            if (!autoplay) return;
            stop();
            timer = setInterval(nextSlide, speed);
          }

          function stop() {
            if (timer) clearInterval(timer);
          }

          if (pauseOnHover) {
            container.addEventListener('mouseenter', stop);
            container.addEventListener('mouseleave', start);
          }

          start();
        }

        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('[data-slider]').forEach(initSlider);
        });
      })();
      </script>
